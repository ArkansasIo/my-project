(* NUDL 0.4 proposed grammar. Draft only; not yet implemented by nudlc. *)
source          = { module_decl | import_decl | declaration } ;
module_decl     = "module", qualified_name, ";" ;
import_decl     = "import", qualified_name, [ "as", identifier ], ";" ;
declaration     = [ visibility ], (binding | function | type_alias | struct_decl | class_decl | enum_decl | union_decl | trait_decl | impl_decl | dataset_decl | table_decl) ;
visibility      = "pub" | "private" ;
binding         = ("let" | "var" | "const"), identifier, [ ":", type ], "=", expression, ";" ;
function        = [ "async" ], "fn", identifier, [ type_parameters ], "(", [ parameters ], ")", "->", type, block ;
parameters      = parameter, { ",", parameter } ;
parameter       = identifier, ":", type ;
type_parameters = "<", identifier, { ",", identifier }, ">" ;
type            = qualified_name | generic_type | tuple_type | function_type | "Option", "<", type, ">" | "Result", "<", type, ",", type, ">" ;
generic_type    = qualified_name, "<", type, { ",", type }, ">" ;
tuple_type      = "(", type, { ",", type }, ")" ;
function_type   = "fn", "(", [ type, { ",", type } ], ")", "->", type ;
type_alias      = "type", identifier, [ type_parameters ], "=", type, ";" ;
struct_decl     = "struct", identifier, [ type_parameters ], "{", { field_decl }, "}" ;
class_decl      = "class", identifier, [ ":", type ], [ type_parameters ], "{", { field_decl | function }, "}" ;
field_decl      = [ visibility ], identifier, ":", type, [ "=", expression ], ";" ;
enum_decl       = "enum", identifier, "{", identifier, { ",", identifier }, [ "," ], "}" ;
union_decl      = "union", identifier, "{", union_case, { ",", union_case }, [ "," ], "}" ;
union_case      = identifier, [ "(", type, { ",", type }, ")" ] ;
trait_decl      = "trait", identifier, "{", { function_signature }, "}" ;
function_signature = "fn", identifier, "(", [ parameters ], ")", "->", type, ";" ;
impl_decl       = "impl", [ qualified_name, "for" ], type, block ;
dataset_decl    = "dataset", identifier, ":", qualified_name, block ;
table_decl      = "table", identifier, ":", qualified_name, block ;
block           = "{", { statement | declaration }, "}" ;
statement       = expression, ";" | "return", [ expression ], ";" | "if", expression, block, [ "else", block ] | "while", expression, block | "for", identifier, "in", expression, block | "break", ";" | "continue", ";" ;
expression      = logical_or ;
logical_or      = logical_and, { "or", logical_and } ;
logical_and     = comparison, { "and", comparison } ;
comparison      = range, { ("==" | "!=" | "<" | "<=" | ">" | ">=" | "is"), range } ;
range           = additive, [ "..", additive ] ;
additive        = multiplicative, { ("+" | "-"), multiplicative } ;
multiplicative  = unary, { ("*" | "/" | "%"), unary } ;
unary           = [ "+" | "-" | "not" ], postfix ;
postfix         = primary, { call_suffix | member_suffix | index_suffix } ;
call_suffix     = "(", [ expression, { ",", expression } ], ")" ;
member_suffix   = ".", identifier ;
index_suffix    = "[", expression, "]" ;
primary         = number | string | "true" | "false" | "null" | identifier | array_literal | tuple_literal | "(", expression, ")" ;
array_literal   = "[", [ expression, { ",", expression } ], "]" ;
tuple_literal   = "(", expression, ",", expression, { ",", expression }, ")" ;
qualified_name  = identifier, { ".", identifier } ;
identifier      = letter, { letter | digit | "_" } ;
number          = digit, { digit }, [ ".", digit, { digit } ], [ ("e" | "E"), [ "+" | "-" ], digit, { digit } ] ;
string          = '"', { string_char | escape }, '"' ;
escape          = "\\", ( '"' | "\\" | "n" | "r" | "t" | "0" ) ;
letter          = "A"…"Z" | "a"…"z" | "_" ;
digit           = "0"…"9" ;
