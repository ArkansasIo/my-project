NUDL 0.3

SYSTEM RuntimeProfile VERSION 1
  MEMORY
    MAX_HEAP 512 MiB
    STACK_PER_THREAD 2 MiB
  END

  EXECUTION
    WORKERS AUTO
    MAX_TASKS 4096
    DETERMINISTIC_MODE false
  END

  SECURITY
    DEFAULT_PERMISSION DENY
    NETWORK_ACCESS DISABLED
    FILESYSTEM_ACCESS SANDBOXED
    REQUIRE_EXPLICIT_CAPABILITY true
  END

  LOGGING
    LEVEL INFO
    STRUCTURED true
  END
END
